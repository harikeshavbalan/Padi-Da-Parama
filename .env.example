# ============================================================
# Environment Variables Configuration
# ============================================================

# Option 1: Full Database URL (Supabase Pooler / Direct)
# DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Option 2: Discrete parameters
DB_TYPE=postgresql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_SSLMODE=require

# Optional Tomcat port
PORT=8080
